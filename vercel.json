{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend_rust": {
      "root": "backend_rust",
      "runtime": "rust",
      "entrypoint": "src/main.rs"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "backend_rust",
          "format": "url",
          "env": "BACKEND_RUST_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend_rust"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
